#############################
# Backup DB App - .env.example
#############################

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=
R2_BUCKET=
R2_USE_PATH_STYLE_ENDPOINT=
R2_ENDPOINT=
R2_URL=

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url

# PostgreSQL Databases
PG_DATABASES=db1,db2,db3
PG_USERS=user1,user2,user3
PG_PASSWORDS=pass1,pass2,pass3
PG_HOSTS=host1,host2,host3
PG_PORTS=port1,port2,port3

# MySQL Databases
MYSQL_DATABASES=db1,db2,db3
MYSQL_USERS=user1,user2,user3
MYSQL_PASSWORDS=pass1,pass2,pass3
MYSQL_HOSTS=host1,host2,host3
MYSQL_PORTS=port1,port2,port3

# Server
# PORT for Bun server (default: 3000)
PORT=3000

# Cron schedules
# Use standard crontab syntax.
# Examples:
# - Every day at 00:00
CRON_SCHEDULE_MYSQL=0 0 * * *
CRON_SCHEDULE_POSTGRESQL=0 0 * * *
# - Every 6 hours
# CRON_SCHEDULE_MYSQL=0 */6 * * *
# CRON_SCHEDULE_POSTGRESQL=0 */6 * * *
# - Every 5 minutes (for testing)
# CRON_SCHEDULE_MYSQL=*/5 * * * *
# CRON_SCHEDULE_POSTGRESQL=*/5 * * * *

# Dump binary paths
# If using the provided Dockerfile, these defaults work because the image installs
# postgresql-client (pg_dump) and default-mysql-client (mysqldump).
# Leave unset to use defaults below.
# PGDUMP_PATH default: pg_dump
# MYSQLDUMP_PATH default: mysqldump
# Uncomment to set explicit paths when running outside Docker.
PGDUMP_PATH=/usr/bin/pg_dump
MYSQLDUMP_PATH=/usr/bin/mysqldump

# Local backup directory (inside container or host)
BACKUP_PATH_LOCAL=./file_backups
BACKUP_PATH_R2=/path/to/r2/backup

# HTTP trigger routes when server is running:
#   GET /mysql       -> triggers backupMysql()
#   GET /postgresql  -> triggers backupPostgresql()


